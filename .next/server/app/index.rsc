,"p",null,{"style":{"color":"var(--gray-600)","fontSize":"15px","lineHeight":1.8,"fontStyle":"italic","marginTop":"16px","flex":1,"position":"relative","zIndex":1},"children":["“","Nunca pensé que trabajar en un campamento americano fuera tan increíble. En Lou Henry Hoover Camp viví una experiencia que cambió mi forma de ver el mundo. Mi inglés mejoró una barbaridad y los niños con los que trabajé me enseñaron más a mí que yo a ellos. Intersunset me acompañó en cada paso sin que me sintiera sola en ningún momento.","”"]}],["$","div",null,{"style":{"height":"1px","background":"#F0F0F8","margin":"24px 0"}}],["$","div",null,{"style":{"display":"flex","alignItems":"center","gap":"14px"},"children":[["$","div",null,{"style":{"width":"80px","height":"80px","borderRadius":"50%","overflow":"hidden","position":"relative","flexShrink":0,"border":"3px solid var(--orange)"},"children":["$","$L3",null,{"src":"/testimonio-elisabeth.webp","alt":"Elisabeth M.","fill":true,"style":{"objectFit":"cover","objectPosition":"center top"}}]}],["$","div",null,{"children":[["$","p",null,{"style":{"color":"var(--navy)","fontWeight":700,"fontSize":"15px","marginBottom":"2px"},"children":"Elisabeth M."}],["$","p",null,{"style":{"color":"var(--gray-400)","fontSize":"12px","marginBottom":"3px"},"children":"Madrid"}],["$","p",null,{"style":{"color":"var(--orange)","fontSize":"12px","fontWeight":600},"children":"Lou Henry Hoover Camp · Verano 2024"}]]}]]}]]}],["$","div","Eric G.",{"className":"reveal-scale reveal-delay-2","style":{"background":"#fff","borderRadius":"20px","padding":"32px","boxShadow":"0 4px 24px rgba(30,29,72,0.08)","display":"flex","flexDirection":"column","position":"relative","overflow":"hidden"},"children":[["$","div",null,{"aria-hidden":true,"style":{"position":"absolute","top":"8px","right":"20px","fontSize":"80px","fontWeight":900,"color":"var(--orange)","opacity":0.1,"lineHeight":1,"userSelect":"none","pointerEvents":"none","fontFamily":"Georgia, serif"},"children":"“"}],["